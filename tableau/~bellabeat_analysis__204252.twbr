                  <column datatype='integer' name='total_sleep_records' ordinal='8' />
                  <column datatype='integer' name='total_minutes_asleep' ordinal='9' />
                  <column datatype='integer' name='total_time_in_bed' ordinal='10' />
                  <column datatype='real' name='total_sleep_hrs' ordinal='11' />
                  <column datatype='real' name='sleep_efficiency' ordinal='12' />
